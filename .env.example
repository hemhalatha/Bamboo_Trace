# Copy this file to .env before running Docker Compose.
# Replace all production secrets and public URLs before deploying.

POSTGRES_DB=bambootrace
POSTGRES_USER=bambootrace
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bambootrace:change-this-postgres-password@db:5432/bambootrace
JWT_SECRET_KEY=change-this-to-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
RUN_DB_STARTUP_TASKS=true

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Flutter web release builds require a full HTTPS API URL in this app.
API_BASE_URL=https://api.your-domain.example