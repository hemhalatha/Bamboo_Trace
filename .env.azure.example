# Copy to .env on the Azure VM and replace every placeholder.
# Do not commit the populated .env file.

# Azure Database for PostgreSQL Flexible Server.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg2://bambootrace_user:replace-with-url-encoded-password@your-server.postgres.database.azure.com:5432/bambootrace?sslmode=require

# Public HTTPS origin (DNS and TLS termination must already be configured).
ALLOWED_ORIGINS=https://your-domain.example
API_BASE_URL=https://your-domain.example/api

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=production
ALLOWED_ORIGIN_REGEX=
RUN_DB_STARTUP_TASKS=false

# These ports are bound to localhost and served through Nginx.
BACKEND_PORT=8000
FRONTEND_PORT=8080
