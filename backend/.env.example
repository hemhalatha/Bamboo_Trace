# Development example only. Set real values in your deployment environment.
DATABASE_URL=postgresql://bambootrace:bambootrace@localhost:5432/bambootrace
JWT_SECRET_KEY=change-this-to-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
RUN_DB_STARTUP_TASKS=true

# Production requirements:
# APP_ENV=production
# ALLOWED_ORIGINS=https://your-deployed-frontend.example
# ALLOWED_ORIGIN_REGEX=
# RUN_DB_STARTUP_TASKS=false
